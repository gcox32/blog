---
import { SITE_AUTHOR, SOCIAL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span>&copy; {year} {SITE_AUTHOR}</span>
	<div class="social">
		<a class="link" href="/rss.xml">RSS</a>
		<a
			class="icon-link"
			href={SOCIAL.github}
			rel="me noopener"
			target="_blank"
			aria-label="Grant on GitHub"
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.575.106.785-.25.785-.556 0-.274-.01-1-.015-1.965-3.196.695-3.87-1.54-3.87-1.54-.523-1.328-1.276-1.682-1.276-1.682-1.043-.713.08-.698.08-.698 1.153.081 1.76 1.184 1.76 1.184 1.026 1.757 2.69 1.25 3.345.955.104-.743.402-1.25.73-1.538-2.553-.29-5.236-1.276-5.236-5.68 0-1.255.448-2.28 1.183-3.084-.119-.29-.513-1.459.112-3.042 0 0 .965-.309 3.163 1.178A11.02 11.02 0 0 1 12 5.8c.977.004 1.962.132 2.882.387 2.196-1.487 3.16-1.178 3.16-1.178.626 1.583.232 2.752.114 3.042.737.804 1.182 1.829 1.182 3.084 0 4.415-2.687 5.386-5.248 5.67.413.355.78 1.056.78 2.129 0 1.537-.014 2.776-.014 3.153 0 .308.207.667.79.554A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
			</svg>
		</a>
		<a
			class="icon-link"
			href={SOCIAL.x}
			rel="me noopener"
			target="_blank"
			aria-label="Grant on X"
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z" />
			</svg>
		</a>
		<a
			class="icon-link"
			href={SOCIAL.linkedin}
			rel="me noopener"
			target="_blank"
			aria-label="Grant on LinkedIn"
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z" />
			</svg>
		</a>
		<a class="icon-link" href={`mailto:${SOCIAL.email}`} aria-label="Email Grant">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67Z" />
				<path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z" />
			</svg>
		</a>
	</div>
</footer>

<style>
	.site-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		max-width: var(--measure);
		margin-inline: auto;
		padding: 1.5rem var(--space) 2.5rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.social {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.icon-link {
		display: inline-grid;
		place-items: center;
		color: var(--text-muted);
		transition: color 0.18s var(--ease);
	}

	.icon-link:hover {
		color: var(--accent);
	}
</style>
